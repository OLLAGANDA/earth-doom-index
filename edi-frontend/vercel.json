{
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/og.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/og", "dest": "api/og.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
